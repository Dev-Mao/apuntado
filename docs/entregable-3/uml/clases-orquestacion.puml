@startuml clases-orquestacion
skinparam shadowing false
skinparam defaultFontSize 12
skinparam dpi 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #33526E
  ArrowColor #33526E
}
hide empty members

package "game/application" #F7F4FA {
  class DeclareClosure {
    - games : GameRepository
    - rules : RuleResolver
    - journal : PlayJournal
    - events : EventBus
    - clock : Clock
    + execute(command : DeclareClosureCommand) : ValidationResult
  }
  interface GameRepository <<port>> {
    + find(gameId : string) : GameSession | null
    + save(session : GameSession) : void
    + delete(gameId : string) : void
  }
  interface PlayJournal <<port>> {
    + record(entry : PlayJournalEntry) : void
  }
  interface EventBus <<port>> {
    + publish(eventName : string, payload : Record<string, unknown>) : void
  }
}
package "game/infrastructure y shared" #F7F4FA {
  class InMemoryGameRepository
  class PgPlayJournal {
    - database : Database
    + record(entry : PlayJournalEntry) : void
  }
  class InProcessEventBus {
    + subscribe(eventName : string, handler : EventHandler) : void
    + publish(eventName : string, payload : Record<string, unknown>) : void
  }
}
package "game/domain/session y match" #FFFFFF {
  class GameSession {
    - status : SessionStatus
    - roundNumber : number
    - pending : GameEvent[]
    - match : Match
    - round : Round
    + id : string {readOnly}
    + matchId : string {readOnly}
    + config : SessionConfig {readOnly}
    + {static} start(ids : SessionIds, playerIds : string[], config : SessionConfig, deps : SessionDependencies) : GameSession
    + declareClosure(playerId : string, declaration : ClosureDeclaration, rule : GameRule) : ValidationResult
    + startNextRound() : Outcome
    + pullEvents() : GameEvent[]
    - settle() : void
    - finish() : void
  }
  class Match {
    - status : MatchStatus
    - winner : string | null
    - dealer : number
    - seats : Seat[]
    + config : MatchConfig {readOnly}
    + {static} create(playerIds : string[], config : MatchConfig) : Match
    + recordRound(scores : RoundScore[], roundWinnerId : string | null) : void
    - eliminateAndMaybeFinish(scores : RoundScore[]) : void
    - best(candidates : Seat[]) : Seat
    - finish(winnerId : string) : void
  }
  class Round {
    - phase : RoundPhase
    - status : RoundStatus
    - closure : RoundClosure | null
    - hands : Map<string, Card[]>
    - stock : Card[]
    - discardPile : Card[]
    - turnIndex : number
    + handOf(playerId : string) : Card[]
    + drawFromStock(playerId : string) : Outcome
    + discard(playerId : string, card : Card) : Outcome
    + declareClosure(playerId : string, declaration : ClosureDeclaration, rule : GameRule) : ValidationResult
    - recycleDiscardPile() : boolean
    - passTurn() : void
  }
}
package "game/domain/rules (Strategy)" #EEF6F0 {
  interface GameRule {
    + validate(declaration : ClosureDeclaration) : ValidationResult
  }
  class RuleResolver {
    + resolve(type : ClosureType, enabled : ClosureType[]) : GameRule | null
  }
}
DeclareClosure --> GameRepository
DeclareClosure --> PlayJournal
DeclareClosure --> EventBus
GameRepository <|.. InMemoryGameRepository
PlayJournal <|.. PgPlayJournal
EventBus <|.. InProcessEventBus
DeclareClosure ..> GameSession : declareClosure()
DeclareClosure --> RuleResolver
GameSession *-- "1" Match
GameSession *-- "1" Round
Round ..> GameRule : validate()
RuleResolver o-- "1..*" GameRule
InMemoryGameRepository -[hidden]down- GameSession
PgPlayJournal -[hidden]down- GameSession
Match -[hidden]down- RuleResolver
@enduml
