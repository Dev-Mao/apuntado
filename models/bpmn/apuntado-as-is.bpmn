<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AsIs">
    <bpmn:participant id="Participant_Mesa" name="Mesa de juego presencial" processRef="Process_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AsIs">
      <bpmn:lane id="Lane_A" name="Jugador en turno">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Barajar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Repartir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Voltear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Tomar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Evaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Cierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Declarar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Descartar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B" name="Demás jugadores">
        <bpmn:flowNodeRef>T_Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Acepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Contar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Discutir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Anotador">
        <bpmn:flowNodeRef>T_Anotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Sumar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_101</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Eliminar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Los jugadores se reúnen">
      <bpmn:outgoing>af1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T_Barajar" name="Barajar manualmente">
      <bpmn:incoming>af1</bpmn:incoming>
      <bpmn:incoming>af22</bpmn:incoming>
      <bpmn:outgoing>af2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Repartir" name="Repartir 10 cartas a cada jugador">
      <bpmn:incoming>af2</bpmn:incoming>
      <bpmn:outgoing>af3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Voltear" name="Voltear una carta al pozo">
      <bpmn:incoming>af3</bpmn:incoming>
      <bpmn:outgoing>af4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Tomar" name="Tomar carta del mazo o del pozo">
      <bpmn:incoming>af4</bpmn:incoming>
      <bpmn:incoming>af9</bpmn:incoming>
      <bpmn:incoming>af14</bpmn:incoming>
      <bpmn:outgoing>af5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Evaluar" name="Evaluar mentalmente la mano">
      <bpmn:incoming>af5</bpmn:incoming>
      <bpmn:outgoing>af6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Cierre" name="¿Cree tener un cierre?">
      <bpmn:incoming>af6</bpmn:incoming>
      <bpmn:outgoing>af7</bpmn:outgoing>
      <bpmn:outgoing>af8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Declarar" name="Declarar cierre en voz alta">
      <bpmn:incoming>af7</bpmn:incoming>
      <bpmn:outgoing>af10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Descartar" name="Descartar una carta">
      <bpmn:incoming>af8</bpmn:incoming>
      <bpmn:outgoing>af9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Verificar" name="Verificar visualmente las combinaciones">
      <bpmn:incoming>af10</bpmn:incoming>
      <bpmn:outgoing>af11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Acepta" name="¿La mesa acepta el cierre?">
      <bpmn:incoming>af11</bpmn:incoming>
      <bpmn:outgoing>af12</bpmn:outgoing>
      <bpmn:outgoing>af13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Contar" name="Contar el valor de sus cartas sueltas">
      <bpmn:incoming>af12</bpmn:incoming>
      <bpmn:outgoing>af15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Discutir" name="Discutir la jugada y reanudar el turno">
      <bpmn:incoming>af13</bpmn:incoming>
      <bpmn:outgoing>af14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Anotar" name="Registrar los puntajes en papel">
      <bpmn:incoming>af15</bpmn:incoming>
      <bpmn:outgoing>af16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Sumar" name="Sumar los acumulados">
      <bpmn:incoming>af16</bpmn:incoming>
      <bpmn:outgoing>af17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_101" name="¿Alguien alcanzó 101 puntos?">
      <bpmn:incoming>af17</bpmn:incoming>
      <bpmn:outgoing>af18</bpmn:outgoing>
      <bpmn:outgoing>af19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Eliminar" name="Declarar eliminado al jugador">
      <bpmn:incoming>af18</bpmn:incoming>
      <bpmn:outgoing>af20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Fin" name="¿Queda un solo jugador?">
      <bpmn:incoming>af19</bpmn:incoming>
      <bpmn:incoming>af20</bpmn:incoming>
      <bpmn:outgoing>af21</bpmn:outgoing>
      <bpmn:outgoing>af22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_1" name="Fin de la partida">
      <bpmn:incoming>af21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="af1" sourceRef="Start_1" targetRef="T_Barajar" />
    <bpmn:sequenceFlow id="af2" sourceRef="T_Barajar" targetRef="T_Repartir" />
    <bpmn:sequenceFlow id="af3" sourceRef="T_Repartir" targetRef="T_Voltear" />
    <bpmn:sequenceFlow id="af4" sourceRef="T_Voltear" targetRef="T_Tomar" />
    <bpmn:sequenceFlow id="af5" sourceRef="T_Tomar" targetRef="T_Evaluar" />
    <bpmn:sequenceFlow id="af6" sourceRef="T_Evaluar" targetRef="Gw_Cierre" />
    <bpmn:sequenceFlow id="af7" name="Sí" sourceRef="Gw_Cierre" targetRef="T_Declarar" />
    <bpmn:sequenceFlow id="af8" name="No" sourceRef="Gw_Cierre" targetRef="T_Descartar" />
    <bpmn:sequenceFlow id="af9" name="Turno del siguiente jugador" sourceRef="T_Descartar" targetRef="T_Tomar" />
    <bpmn:sequenceFlow id="af10" sourceRef="T_Declarar" targetRef="T_Verificar" />
    <bpmn:sequenceFlow id="af11" sourceRef="T_Verificar" targetRef="Gw_Acepta" />
    <bpmn:sequenceFlow id="af12" name="Sí" sourceRef="Gw_Acepta" targetRef="T_Contar" />
    <bpmn:sequenceFlow id="af13" name="No" sourceRef="Gw_Acepta" targetRef="T_Discutir" />
    <bpmn:sequenceFlow id="af14" name="Se reanuda el turno" sourceRef="T_Discutir" targetRef="T_Tomar" />
    <bpmn:sequenceFlow id="af15" sourceRef="T_Contar" targetRef="T_Anotar" />
    <bpmn:sequenceFlow id="af16" sourceRef="T_Anotar" targetRef="T_Sumar" />
    <bpmn:sequenceFlow id="af17" sourceRef="T_Sumar" targetRef="Gw_101" />
    <bpmn:sequenceFlow id="af18" name="Sí" sourceRef="Gw_101" targetRef="T_Eliminar" />
    <bpmn:sequenceFlow id="af19" name="No" sourceRef="Gw_101" targetRef="Gw_Fin" />
    <bpmn:sequenceFlow id="af20" sourceRef="T_Eliminar" targetRef="Gw_Fin" />
    <bpmn:sequenceFlow id="af21" name="Sí" sourceRef="Gw_Fin" targetRef="End_1" />
    <bpmn:sequenceFlow id="af22" name="No: se juega otra ronda" sourceRef="Gw_Fin" targetRef="T_Barajar" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_AsIs" bpmnElement="Collaboration_AsIs">
