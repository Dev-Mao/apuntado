<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Jugador" name="Jugador" processRef="Process_Jugador" />
    <bpmn:participant id="Participant_Orq" name="Sistema / Orquestador de Juego" processRef="Process_Orq" />
    <bpmn:participant id="Participant_Motor" name="Motor de Reglas / Puntaje" processRef="Process_Motor" />
    <bpmn:messageFlow id="msg1" name="Crear partida" sourceRef="T_J1" targetRef="Start_O" />
    <bpmn:messageFlow id="msg2" name="Configuración de reglas" sourceRef="T_J2" targetRef="T_O1" />
    <bpmn:messageFlow id="msg3" name="Intención de juego" sourceRef="T_J3" targetRef="T_O5" />
    <bpmn:messageFlow id="msg4" name="Estado actualizado (vista filtrada)" sourceRef="T_O7" targetRef="T_J4" />
    <bpmn:messageFlow id="msg5" name="Solicitud de validación" sourceRef="T_O5" targetRef="Start_M" />
    <bpmn:messageFlow id="msg6" name="Resultado de validación" sourceRef="End_M_ok" targetRef="T_O6" />
    <bpmn:messageFlow id="msg7" name="Motivo del rechazo" sourceRef="End_M_rech" targetRef="T_O7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Jugador" isExecutable="false">
    <bpmn:startEvent id="Start_J" name="Ingresar a la plataforma">
      <bpmn:outgoing>jf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_J1" name="Crear partida o unirse con código">
      <bpmn:incoming>jf1</bpmn:incoming>
      <bpmn:outgoing>jf2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_J2" name="Seleccionar modalidad y parámetros de reglas">
      <bpmn:incoming>jf2</bpmn:incoming>
      <bpmn:outgoing>jf3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_J3" name="Seleccionar una acción: robar, descartar o cerrar">
      <bpmn:incoming>jf3</bpmn:incoming>
      <bpmn:outgoing>jf4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_J4" name="Visualizar el estado actualizado">
      <bpmn:incoming>jf4</bpmn:incoming>
      <bpmn:outgoing>jf5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_J" name="Consultar el resultado de la partida">
      <bpmn:incoming>jf5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="jf1" sourceRef="Start_J" targetRef="T_J1" />
    <bpmn:sequenceFlow id="jf2" sourceRef="T_J1" targetRef="T_J2" />
    <bpmn:sequenceFlow id="jf3" sourceRef="T_J2" targetRef="T_J3" />
    <bpmn:sequenceFlow id="jf4" sourceRef="T_J3" targetRef="T_J4" />
    <bpmn:sequenceFlow id="jf5" sourceRef="T_J4" targetRef="End_J" />
  </bpmn:process>
  <bpmn:process id="Process_Orq" isExecutable="false">
    <bpmn:startEvent id="Start_O" name="Partida solicitada">
      <bpmn:outgoing>of1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_O" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_O1" name="Registrar la configuración de reglas">
      <bpmn:incoming>of1</bpmn:incoming>
      <bpmn:outgoing>of2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_O2" name="Generar y mezclar la baraja">
      <bpmn:incoming>of2</bpmn:incoming>
      <bpmn:outgoing>of3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_O3" name="Repartir 10 cartas y abrir el pozo">
      <bpmn:incoming>of3</bpmn:incoming>
      <bpmn:outgoing>of4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_O4" name="Habilitar el turno del jugador">
      <bpmn:incoming>of4</bpmn:incoming>
      <bpmn:incoming>of11</bpmn:incoming>
      <bpmn:outgoing>of5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_Timer" name="Tiempo de turno vencido" attachedToRef="T_O4" cancelActivity="true">
      <bpmn:outgoing>of12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_Timer" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_O5" name="Recibir la intención del jugador">
      <bpmn:incoming>of5</bpmn:incoming>
      <bpmn:outgoing>of6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Timeout" name="Resolver el turno automáticamente">
      <bpmn:incoming>of12</bpmn:incoming>
      <bpmn:outgoing>of13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_O6" name="Aplicar la jugada al estado de la partida">
      <bpmn:incoming>of6</bpmn:incoming>
      <bpmn:incoming>of13</bpmn:incoming>
      <bpmn:outgoing>of7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_O7" name="Difundir el estado a los jugadores">
      <bpmn:incoming>of7</bpmn:incoming>
      <bpmn:outgoing>of8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_O" name="¿Partida finalizada?">
      <bpmn:incoming>of8</bpmn:incoming>
      <bpmn:outgoing>of9</bpmn:outgoing>
      <bpmn:outgoing>of11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_O8" name="Persistir el resultado de la partida">
      <bpmn:incoming>of9</bpmn:incoming>
      <bpmn:outgoing>of10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_O" name="Partida finalizada">
      <bpmn:incoming>of10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="of1" sourceRef="Start_O" targetRef="T_O1" />
    <bpmn:sequenceFlow id="of2" sourceRef="T_O1" targetRef="T_O2" />
    <bpmn:sequenceFlow id="of3" sourceRef="T_O2" targetRef="T_O3" />
    <bpmn:sequenceFlow id="of4" sourceRef="T_O3" targetRef="T_O4" />
    <bpmn:sequenceFlow id="of5" sourceRef="T_O4" targetRef="T_O5" />
    <bpmn:sequenceFlow id="of6" sourceRef="T_O5" targetRef="T_O6" />
    <bpmn:sequenceFlow id="of7" sourceRef="T_O6" targetRef="T_O7" />
    <bpmn:sequenceFlow id="of8" sourceRef="T_O7" targetRef="Gw_O" />
    <bpmn:sequenceFlow id="of9" name="Sí" sourceRef="Gw_O" targetRef="T_O8" />
    <bpmn:sequenceFlow id="of10" sourceRef="T_O8" targetRef="End_O" />
    <bpmn:sequenceFlow id="of11" name="No: nueva ronda" sourceRef="Gw_O" targetRef="T_O4" />
    <bpmn:sequenceFlow id="of12" name="Tiempo vencido" sourceRef="B_Timer" targetRef="T_Timeout" />
    <bpmn:sequenceFlow id="of13" sourceRef="T_Timeout" targetRef="T_O6" />
  </bpmn:process>
  <bpmn:process id="Process_Motor" isExecutable="false">
    <bpmn:startEvent id="Start_M" name="Solicitud de validación">
      <bpmn:outgoing>mf1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_M" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_M1" name="Validar la legalidad de la acción">
      <bpmn:incoming>mf1</bpmn:incoming>
      <bpmn:outgoing>mf2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_M1" name="¿Acción válida?">
      <bpmn:incoming>mf2</bpmn:incoming>
      <bpmn:outgoing>mf3</bpmn:outgoing>
      <bpmn:outgoing>mf4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_M2" name="¿Declaró cierre?">
      <bpmn:incoming>mf3</bpmn:incoming>
      <bpmn:outgoing>mf6</bpmn:outgoing>
      <bpmn:outgoing>mf7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_M_ok" name="Jugada válida">
      <bpmn:incoming>mf6</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_End_M_ok" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_M_rechazo" name="Notificar el motivo del rechazo">
      <bpmn:incoming>mf4</bpmn:incoming>
      <bpmn:incoming>mf11</bpmn:incoming>
      <bpmn:outgoing>mf5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_M_rech" name="Rechazo notificado">
      <bpmn:incoming>mf5</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_End_M_rech" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_M3" name="¿Tiene 1 cuarta y 2 ternas?">
      <bpmn:incoming>mf7</bpmn:incoming>
      <bpmn:outgoing>mf8</bpmn:outgoing>
      <bpmn:outgoing>mf9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_M4" name="¿Tiene 3 ternas y sobrante &lt; 5 pts?">
      <bpmn:incoming>mf9</bpmn:incoming>
      <bpmn:outgoing>mf10</bpmn:outgoing>
      <bpmn:outgoing>mf11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_M_liq" name="Calcular cartas sueltas y acumular puntaje">
      <bpmn:incoming>mf8</bpmn:incoming>
      <bpmn:incoming>mf10</bpmn:incoming>
      <bpmn:outgoing>mf12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_M5" name="¿Puntaje igual o superior a 101?">
      <bpmn:incoming>mf12</bpmn:incoming>
      <bpmn:outgoing>mf13</bpmn:outgoing>
      <bpmn:outgoing>mf15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_M_elim" name="Marcar al jugador como eliminado">
      <bpmn:incoming>mf13</bpmn:incoming>
      <bpmn:outgoing>mf14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_M_ronda" name="Ronda liquidada">
      <bpmn:incoming>mf14</bpmn:incoming>
      <bpmn:incoming>mf15</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_End_M_ronda" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mf1" sourceRef="Start_M" targetRef="T_M1" />
    <bpmn:sequenceFlow id="mf2" sourceRef="T_M1" targetRef="Gw_M1" />
    <bpmn:sequenceFlow id="mf3" name="Sí" sourceRef="Gw_M1" targetRef="Gw_M2" />
    <bpmn:sequenceFlow id="mf4" name="No" sourceRef="Gw_M1" targetRef="T_M_rechazo" />
    <bpmn:sequenceFlow id="mf5" sourceRef="T_M_rechazo" targetRef="End_M_rech" />
    <bpmn:sequenceFlow id="mf6" name="No" sourceRef="Gw_M2" targetRef="End_M_ok" />
    <bpmn:sequenceFlow id="mf7" name="Sí" sourceRef="Gw_M2" targetRef="Gw_M3" />
    <bpmn:sequenceFlow id="mf8" name="Sí: cierre clásico" sourceRef="Gw_M3" targetRef="T_M_liq" />
    <bpmn:sequenceFlow id="mf9" name="No" sourceRef="Gw_M3" targetRef="Gw_M4" />
    <bpmn:sequenceFlow id="mf10" name="Sí: cierre por apuntado" sourceRef="Gw_M4" targetRef="T_M_liq" />
    <bpmn:sequenceFlow id="mf11" name="No: cierre inválido" sourceRef="Gw_M4" targetRef="T_M_rechazo" />
    <bpmn:sequenceFlow id="mf12" sourceRef="T_M_liq" targetRef="Gw_M5" />
    <bpmn:sequenceFlow id="mf13" name="Sí" sourceRef="Gw_M5" targetRef="T_M_elim" />
    <bpmn:sequenceFlow id="mf14" sourceRef="T_M_elim" targetRef="End_M_ronda" />
    <bpmn:sequenceFlow id="mf15" name="No" sourceRef="Gw_M5" targetRef="End_M_ronda" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_ToBe" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_Jugador_di" bpmnElement="Participant_Jugador" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2000" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Orq_di" bpmnElement="Participant_Orq" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="2000" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Motor_di" bpmnElement="Participant_Motor" isHorizontal="true">
        <dc:Bounds x="160" y="640" width="2000" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_J_di" bpmnElement="Start_J">
        <dc:Bounds x="232" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="207" y="203" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_J1_di" bpmnElement="T_J1">
        <dc:Bounds x="310" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_J2_di" bpmnElement="T_J2">
        <dc:Bounds x="460" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_J3_di" bpmnElement="T_J3">
        <dc:Bounds x="950" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_J4_di" bpmnElement="T_J4">
        <dc:Bounds x="1400" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_J_di" bpmnElement="End_J">
        <dc:Bounds x="1900" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1875" y="203" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_O_di" bpmnElement="Start_O">
        <dc:Bounds x="232" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="207" y="463" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O1_di" bpmnElement="T_O1">
        <dc:Bounds x="310" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O2_di" bpmnElement="T_O2">
        <dc:Bounds x="460" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O3_di" bpmnElement="T_O3">
        <dc:Bounds x="610" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O4_di" bpmnElement="T_O4">
        <dc:Bounds x="760" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Timer_di" bpmnElement="B_Timer">
        <dc:Bounds x="842" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="817" y="503" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O5_di" bpmnElement="T_O5">
        <dc:Bounds x="950" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Timeout_di" bpmnElement="T_Timeout">
        <dc:Bounds x="880" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O6_di" bpmnElement="T_O6">
        <dc:Bounds x="1250" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O7_di" bpmnElement="T_O7">
        <dc:Bounds x="1400" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_O_di" bpmnElement="Gw_O">
        <dc:Bounds x="1560" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1535" y="470" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_O8_di" bpmnElement="T_O8">
        <dc:Bounds x="1660" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_O_di" bpmnElement="End_O">
        <dc:Bounds x="1900" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1875" y="463" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_M_di" bpmnElement="Start_M">
        <dc:Bounds x="232" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="207" y="763" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_M1_di" bpmnElement="T_M1">
        <dc:Bounds x="310" y="700" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_M1_di" bpmnElement="Gw_M1">
        <dc:Bounds x="470" y="715" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="445" y="770" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_M2_di" bpmnElement="Gw_M2">
        <dc:Bounds x="620" y="715" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="595" y="770" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_M_ok_di" bpmnElement="End_M_ok">
        <dc:Bounds x="760" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="735" y="763" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_M_rechazo_di" bpmnElement="T_M_rechazo">
        <dc:Bounds x="420" y="860" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_M_rech_di" bpmnElement="End_M_rech">
        <dc:Bounds x="580" y="882" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="555" y="923" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_M3_di" bpmnElement="Gw_M3">
        <dc:Bounds x="760" y="875" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="735" y="930" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_M4_di" bpmnElement="Gw_M4">
        <dc:Bounds x="920" y="875" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="895" y="930" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_M_liq_di" bpmnElement="T_M_liq">
        <dc:Bounds x="1080" y="860" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_M5_di" bpmnElement="Gw_M5">
        <dc:Bounds x="1240" y="875" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1215" y="930" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_M_elim_di" bpmnElement="T_M_elim">
        <dc:Bounds x="1340" y="860" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_M_ronda_di" bpmnElement="End_M_ronda">
        <dc:Bounds x="1520" y="882" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1495" y="923" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="jf1_di" bpmnElement="jf1">
        <di:waypoint x="268" y="180" />
        <di:waypoint x="310" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jf2_di" bpmnElement="jf2">
        <di:waypoint x="410" y="180" />
        <di:waypoint x="460" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jf3_di" bpmnElement="jf3">
        <di:waypoint x="560" y="180" />
        <di:waypoint x="950" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jf4_di" bpmnElement="jf4">
