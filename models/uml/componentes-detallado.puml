@startuml componentes-detallado
' Entregable 2 · §1.3 — Diagrama UML de componentes detallado con puertos e interfaces
' Monolito modular con particionamiento por dominio (ADR-01) y Strategy para reglas (ADR-03)

title Componentes detallados — Monolito modular, particionamiento por dominio

top to bottom direction
skinparam linetype ortho
skinparam nodesep 18
skinparam ranksep 45
skinparam componentStyle uml2
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam component {
  BackgroundColor #F7F9FC
  BorderColor #33526E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #33526E
}

component "Cliente Web (SPA)" as UI <<externo>>

package "Módulo: Juego (game)" #F3F8F1 {

  package "interfaces" {
    component "ControladorHttp" as HTTP
    component "PasarelaWebSocket" as WS
  }

  package "application" {
    component "JugarTurno" as UC1
    component "DeclararCierre" as UC2
    component "LiquidarRonda" as UC3
    interface "AccionesDeJuego" as I_AJ
    interface "EventosDePartida" as I_EP
  }

  package "domain · núcleo estable" {
    component "MaquinaDeEstados" as SM
    component "RepartidorDeBaraja" as DECK
    component "ProyectorDeVista" as VIEW
    interface "ProyeccionDeVista" as I_PV
  }

  package "domain · reglas (punto de extensión)" #FFFDF5 {
    component "ResolutorDeReglas\n<<registry>>" as RR
    interface "ReglaJuego\n<<contract>>" as I_RULE
    component "ReglaClasica" as R1
    component "ReglaApuntado" as R2
    component "ReglaConComodin\n<<futura>>" as R3
    component "EvaluadorDeMano\nCe = 0" as EVAL
    component "CalculadorDePuntaje\nCe = 0" as SCORE
    interface "EvaluacionDeMano" as I_EM
    interface "CalculoDePuntaje" as I_CP
  }

  package "application · puertos requeridos" #F7F4FA {
    interface "RepositorioDePartidas" as I_REPO
    interface "BitacoraDeJugadas" as I_JOURNAL
    interface "GarantiaDeApuesta" as I_STAKE
    interface "Reloj" as I_CLOCK
  }

  package "infrastructure" {
    component "PartidasEnMemoria" as MEM
    component "BitacoraAsincrona\n<<cola>>" as JOURNAL
    component "EmisorWebSocket" as EMIT
  }
}

package "Módulo: Economía" #F6F1FA {
  component "CustodioDeApuestas" as STAKE
  component "LibroDeFichas" as LEDGER
}

package "Módulo: Historial" #EEF4FA {
  component "ArchivadorDeHistorial" as HIST
}

package "Módulo: Identidad" #FBF6EE {
  component "AutenticadorDeSesion" as AUTH
  interface "Identidad" as I_ID
}

database "PostgreSQL" as DB <<externo>>

' ---------------- interfaces provistas (lollipop) ----------------
UC1 -up- I_AJ
UC2 -up- I_AJ
UC3 -up- I_EP
VIEW -- I_PV
RR -- I_RULE
EVAL -- I_EM
SCORE -- I_CP
MEM -- I_REPO
JOURNAL -- I_JOURNAL
STAKE -- I_STAKE
AUTH -- I_ID

' ---------------- interfaces requeridas (socket) ----------------
UI ..> I_AJ : intención
HTTP ..> I_AJ
WS ..> I_AJ
UC1 ..> I_REPO
UC1 ..> I_CLOCK
UC2 ..> I_REPO
UC2 ..> I_RULE
UC2 ..> I_JOURNAL
UC3 ..> I_RULE
SM ..> I_RULE
RR ..> I_EM
RR ..> I_CP
HTTP ..> I_ID
UC1 ..> I_STAKE

' ---------------- realización del contrato ----------------
I_RULE <|.. R1
I_RULE <|.. R2
I_RULE <|.. R3
R1 ..> I_EM
R2 ..> I_EM
R2 ..> I_CP

' ---------------- salidas ----------------
UC1 ..> DECK
EMIT ..> I_EP
EMIT ..> UI
JOURNAL --> DB : INSERT asíncrono
HIST ..> I_EP
STAKE ..> LEDGER

note right of I_RULE
  **Contrato del punto de extensión.**
  Agregar una variante (Continental,
  Póker) es implementar esta interfaz
  y registrarla en el ResolutorDeReglas.
  El núcleo no se modifica.
end note

note bottom of I_STAKE
  Interfaz **declarada por Juego**
  e **implementada por Economía**:
  inversión de dependencias (ADR-01).
end note

note bottom of JOURNAL
  Bitácora **fuera del camino crítico**
  del turno (ADR-05): no agrega latencia
  a robar ni a descartar.
end note

@enduml
