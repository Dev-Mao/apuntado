        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;config_reglas&lt;/b&gt; se desnormaliza a propósito (JSONB): el catálogo de puntos de variación crece con cada regla y normalizarlo exigiría una migración por regla." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFF9E0;strokeColor=#B7A160;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1150" y="340" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="Separar &lt;b&gt;valor_carta&lt;/b&gt; de &lt;b&gt;carta&lt;/b&gt; elimina la dependencia transitiva codigo → valor → puntos y deja el esquema en 3FN." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFF9E0;strokeColor=#B7A160;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
