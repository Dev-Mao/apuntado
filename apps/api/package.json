    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/websockets": "^12.4.2",
    "@node-rs/argon2": "^2.2.2",
    "cookie": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
